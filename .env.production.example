# Copy this file to .env before starting the production stack.
# Use a long, unique value. Do not commit the resulting .env file.
POSTGRES_DB=ai_library
POSTGRES_USER=ai_library
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Public HTTP port exposed by the frontend/reverse proxy.
APP_PORT=80

# Set this to the actual HTTPS origin(s), comma-separated.
KIOSK_STREAM_ORIGINS=https://library.example.edu

AI_PROVIDER=mock
VOICE_PROVIDER=mock
FACE_PROVIDER=mock
FACE_DIAGNOSTICS_ENABLED=false

# Required only when AI_PROVIDER uses Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional local OpenCV provider configuration:
# FACE_PROVIDER=local_opencv
# INSTALL_FACE_OPENCV=true
# FACE_MODELS_DIR=./backend/models
# FACE_YUNET_MODEL_PATH=/models/face_detection_yunet_2023mar.onnx
# FACE_SFACE_MODEL_PATH=/models/face_recognition_sface_2021dec.onnx
# FACE_SFACE_COSINE_THRESHOLD=<calibrated cosine threshold>
