.env
.venv/
.venv-codex/
.venv*/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
backend/.env
frontend/.env
frontend/node_modules/
frontend/dist/
.docx-review/
.idea/
.vscode/


# Chặn các file và thư mục build cũ (kể cả bản đóng gói Electron trước đây)
frontend/release/
**/win-unpacked.tmp/
*.exe
dist/
backend/storage/media/**
!backend/storage/media/**/
!backend/storage/media/**/.gitkeep

# Provision ONNX weights outside Git; configure their absolute paths at deploy time.
backend/models/
backend/storage/admin/
*.onnx
# TLS certificates and keys for the LAN server stay on that server.
certs/*
!certs/.gitkeep
*.pem
*.tsbuildinfo
