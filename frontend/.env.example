# Leave empty to use the Vite dev proxy locally and the same-origin Nginx proxy in production.
VITE_API_BASE_URL=
VITE_KIOSK_DEVICE_CODE=KIOSK_DEV_01
# Dev server only: a key issued in Admin → Thiết bị kiosk, so you skip the setup screen.
# Ignored by production builds; real kiosks store their key locally.
VITE_KIOSK_DEVICE_KEY=
VITE_ENABLE_MOCK_FALLBACK=false
VITE_KIOSK_IDLE_TIMEOUT_SECONDS=90
VITE_ENABLE_DEV_CONTROLS=false
VITE_KIOSK_CAMERA_WIDTH=1280
VITE_KIOSK_CAMERA_HEIGHT=720
VITE_KIOSK_UNKNOWN_MIN_MS=4000
VITE_KIOSK_UNKNOWN_ATTEMPTS=3
VITE_KIOSK_CAPTURE_PREPARATION_MS=1800
VITE_KIOSK_REGISTRATION_STABLE_FRAMES=5
VITE_KIOSK_REGISTRATION_STABLE_MS=700
# Voice input: auto (Web Speech when available, otherwise recording + server STT), browser, or server
VITE_VOICE_INPUT=auto
# Dev server only: extra hostnames allowed to reach Vite (e.g. abc.trycloudflare.com), comma-separated
DEV_ALLOWED_HOSTS=
